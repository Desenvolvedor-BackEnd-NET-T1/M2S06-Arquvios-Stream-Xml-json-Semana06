<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- Os arquivos de entrada também vão para bin\Debug\net10.0,
       para os exemplos funcionarem rodando pelo Visual Studio -->
  <ItemGroup>
    <None Update="entrada\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
